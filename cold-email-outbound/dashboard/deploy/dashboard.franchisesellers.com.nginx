server {
    server_name dashboard.franchisesellers.com;

    root /var/www/dashboard;
    index index.html;

    # ════════════════════════════════════════════════════════════════════
    # ACCESS TIERS (2026-06-08) — every dashboard uses ^~ so it beats the
    # shared regex blocks (none remain) and gets its tier's auth + no-cache.
    #   .htpasswd-leadership : Eric, Theodore                → report only
    #   .htpasswd-internal   : leadership, David, Malcolm    → marketing, sales
    #   .htpasswd-ops        : internal + team + Rich,Templa,Alicea,Yvonne,Laura
    #                                                        → toolkit, buyers, full-service, shared, api
    # Existing shared logins (leadership, team) preserved in the tiers so no
    # current user is locked out.
    # ════════════════════════════════════════════════════════════════════

    # ── Public: landing page + its static assets ─────────────────────────
    location = / {
        try_files /index.html =404;
    }
    location = /index.html {
        try_files /index.html =404;
    }
    location = /favicon.ico {
        try_files /favicon.ico =404;
    }
    location = /assets/js/usage-beacon.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    # ── Company Report — LEADERSHIP tier ─────────────────────────────────
    location ^~ /staff-report/ {
        auth_basic           "Company Report (leadership only)";
        auth_basic_user_file /etc/nginx/.htpasswd-leadership;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }
    location ^~ /report/ {
        auth_basic           "Company Report (leadership only)";
        auth_basic_user_file /etc/nginx/.htpasswd-leadership;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # ── Marketing Platform — INTERNAL tier (leadership + David + Malcolm) ─
    location ^~ /marketing/ {
        auth_basic           "Marketing Platform";
        auth_basic_user_file /etc/nginx/.htpasswd-internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }
    location = /marketing { return 301 /marketing/; }

    # ── Sales Hub — INTERNAL tier ────────────────────────────────────────
    location ^~ /sales/ {
        auth_basic           "Sales Hub";
        auth_basic_user_file /etc/nginx/.htpasswd-internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }
    location ^~ /sales-staging/ {
        auth_basic           "Sales Staging";
        auth_basic_user_file /etc/nginx/.htpasswd-internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # ── Toolkit Manager — OPS tier ───────────────────────────────────────
    location ^~ /toolkit/ {
        auth_basic           "Toolkit Manager";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }
    location ^~ /toolkit-staging/ {
        auth_basic           "Toolkit Staging";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # ── Buyer Manager Hub — OPS tier ─────────────────────────────────────
    location ^~ /buyer-manager/ {
        auth_basic           "Buyer Manager";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }
    location ^~ /buyer-manager-staging/ {
        auth_basic           "Buyer Manager Staging";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # ── Shared reference docs — OPS tier ─────────────────────────────────
    location ^~ /shared/ {
        auth_basic           "Shared References";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        try_files $uri $uri/ =404;
    }

    # ── Full Service CM Hub write-proxy (task CRUD → GHL) — OPS tier ──────
    location ^~ /full-service/api/ {
        auth_basic           "Full Service";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        proxy_pass         http://127.0.0.1:8082/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }
    location ^~ /full-service/ {
        auth_basic           "Full Service";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }
    location ^~ /full-service-staging/api/ {
        auth_basic           "Full Service Staging";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        proxy_pass         http://127.0.0.1:8082/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;
    }
    location ^~ /full-service-staging/ {
        auth_basic           "Full Service Staging";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        try_files $uri $uri/ $uri/index.html =404;
    }

    # ── Write API (two-way CRM sync + AI recommendations) — OPS tier ─────
    location ^~ /api/ {
        auth_basic           "Dashboard API";
        auth_basic_user_file /etc/nginx/.htpasswd-ops;
        proxy_pass         http://127.0.0.1:8001/api/;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout    180s;
        proxy_read_timeout    180s;
        proxy_buffering       off;
    }

    # NOTE: the former shared no-cache regex blocks were removed 2026-06-08.
    # Each dashboard above is ^~ (beats regex) with its own auth tier + no-cache,
    # so HTML + snapshot.json under each path inherit the correct tier + freshness.

    # ── Default fallback ─────────────────────────────────────────────────
    location / {
        return 404;
    }

    access_log /var/log/nginx/dashboard.access.log;
    error_log  /var/log/nginx/dashboard.error.log;

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dashboard.franchisesellers.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dashboard.franchisesellers.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = dashboard.franchisesellers.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name dashboard.franchisesellers.com;
    return 404; # managed by Certbot


}
