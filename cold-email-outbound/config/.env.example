# Cold Email Engine — environment / API keys
# Copy to cold-email-outbound/.env and fill in. .env is gitignored.
# The engine reads these only on LIVE (non-dry-run) paths.

# ── Master safety switch ─────────────────────────────────────────────────────
# Leave true until you are ready to actually verify/send. Flip to false to go live.
CEO_DRY_RUN=true

# ── Email verification waterfall (LeadMagic primary -> ZeroBounce fallback) ──
LEADMAGIC_API_KEY=
ZEROBOUNCE_API_KEY=

# ── Sending (Instantly) ──────────────────────────────────────────────────────
INSTANTLY_API_KEY=

# ── CRM (two GoHighLevel workspaces) ─────────────────────────────────────────
# Same var names as the shared workspace .env (Claude COWORK/CRM Reporting/.env).
# Tokens are GHL Private Integration Tokens (pit-...).
GHL_FS_LOCATION_ID=
GHL_FS_API_KEY=
GHL_CS_LOCATION_ID=
GHL_CS_API_KEY=

# ── Reply classification + signal extraction (Anthropic) ─────────────────────
ANTHROPIC_API_KEY=

# ── Phase 2 enrichment (not needed for Phase 1 reactivation) ─────────────────
APOLLO_API_KEY=
PDL_API_KEY=
